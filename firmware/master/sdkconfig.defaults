# ---------- Cible : ESP32-S3 N16R8 (16 Mo flash, 8 Mo PSRAM octale) ----------
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb_ota.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM octale (modules N16R8 / N8R8). Si la PSRAM est absente ou quad, le MASTER démarre quand même.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Console sur l'UART0 (port « COM » CH343). Le port USB natif est réservé à l'hôte USB (Arduino).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Mises à jour OTA avec retour arrière automatique si la nouvelle image ne démarre pas.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Serveur web / WebSocket
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# microSD : noms longs (projets « 34_data_logger_environnemental ») et UTF-8
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096

# TLS (API IA, notifications, mises à jour)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# Système
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Les avertissements restent visibles mais ne bloquent pas le build (voir docs/BUILD.md).
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
