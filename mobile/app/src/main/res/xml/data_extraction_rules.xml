<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : rien n'est copié vers le cloud ni vers un nouveau téléphone (boîte d'envoi, réglages, page web). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" /><exclude domain="file" /><exclude domain="database" /><exclude domain="sharedpref" /><exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" /><exclude domain="file" /><exclude domain="database" /><exclude domain="sharedpref" /><exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
