<?xml version="1.0" encoding="utf-8"?>
<!-- Le box (192.168.4.1), le Pi et les workers sont sur le Wi-Fi local sans certificat : HTTP autorisé.
     Pour HTTPS, seules les autorités du système sont acceptées (jamais un certificat ajouté par l'utilisateur). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
