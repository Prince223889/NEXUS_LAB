# Copie locale protégée par l'installateur; ne jamais committer de jeton réel.
NEXUS_DATA=/srv/nexus
# Le Pi démarre sur la clé USB; la microSD de données est montée sur ce chemin.
NEXUS_SHARED_ROOT=/srv/nexus/shared
NEXUS_PROJECTS=/srv/nexus/shared/PROJECTS/LIBRARY
NEXUS_USER_PROJECTS=/srv/nexus/shared/PROJECTS/MY_PROJECTS
NEXUS_FIRMWARE=/srv/nexus/shared/FIRMWARE
NEXUS_BUILDS=/srv/nexus/shared/BUILD_CACHE
ARDUINO_DATA_DIR=/srv/nexus/shared/ARDUINO
NEXUS_CATALOG=/opt/nexus/catalog/catalog.json
NEXUS_DB=/srv/nexus/database/nexus.sqlite3
NEXUS_PORT=8088
# 1 par défaut; augmente à 2-4 selon la RAM et le refroidissement du Pi.
NEXUS_BUILD_WORKERS=1
ARDUINO_CLI=arduino-cli
# Fournisseur IA facultatif. Laisse vide en mode local.
NEXUS_AI_ENDPOINT=
NEXUS_AI_KEY=
NEXUS_AI_MODEL=

# Réception WhatsApp Cloud API facultative. Ne publie jamais ces valeurs.
# Le webhook exige une URL HTTPS publique et un numéro émetteur dans la liste blanche.
NEXUS_WHATSAPP_VERIFY_TOKEN=
NEXUS_WHATSAPP_APP_SECRET=
NEXUS_WHATSAPP_ALLOWLIST=

NEXUS_APPS=/srv/nexus/apps
NEXUS_ANDROID_TEMPLATE=/opt/nexus/android-template
ANDROID_HOME=/srv/nexus/android-sdk
GRADLE_USER_HOME=/srv/nexus/gradle
